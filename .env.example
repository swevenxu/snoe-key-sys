# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/keysystem

# Server Configuration
PORT=3000
NODE_ENV=development

# Admin API Key (generate a secure random string)
ADMIN_API_KEY=your-super-secret-admin-key-here

# Optional: Custom key prefix (e.g., "MYAPP-XXXX-XXXX-XXXX")
KEY_PREFIX=KEY

# Checkpoint Settings
REQUIRED_CHECKPOINTS=1
CHECKPOINT_KEY_DURATION=1

# Anti-abuse Settings
MAX_KEYS_PER_IP_PER_DAY=3
MAX_KEYS_PER_FINGERPRINT_PER_DAY=3
MAX_KEYS_PER_HWID_PER_DAY=2
KEY_COOLDOWN_HOURS=12
ANTI_ABUSE_ENABLED=true
